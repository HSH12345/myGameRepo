# index.js loads the local file; existing process environment takes precedence.
# Never commit the real .env or the Firebase service-account JSON.
FIREBASE_SERVICE_ACCOUNT=path/to/service-account.json
# Optional: must match the service account and the UE Firebase project.
# FIREBASE_PROJECT_ID=your-project-id
NAVER_CLIENT_ID=your-client-id
NAVER_CLIENT_SECRET=your-client-secret
NAVER_REDIRECT_URI=http://localhost:3000/auth/naver/callback
HOST=127.0.0.1
PORT=3000
