<Window x:Class="RpgServerManager.SecretPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="서버 보안 설정" Width="500" MinHeight="310" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource AppFont}">
    <Border Margin="18" Padding="22" CornerRadius="14" Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="필수 보안 값 입력" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="DescriptionText" Grid.Row="1" Margin="0,8,0,14"
                       Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
            <PasswordBox x:Name="SecretBox" Grid.Row="2" Padding="10,8" FontSize="14"
                         Background="#0D1426" Foreground="{StaticResource TextBrush}"
                         BorderBrush="{StaticResource BorderBrush}" PasswordChar="●" />
            <CheckBox x:Name="RememberBox" Grid.Row="3" Content="Windows 자격 증명에 안전하게 저장"
                      IsChecked="True" Margin="0,12,0,0" Foreground="{StaticResource MutedTextBrush}" />
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="취소" MinWidth="82" Style="{StaticResource SecondaryButton}" Click="Cancel_Click" Margin="0,0,8,0" />
                <Button Content="저장하고 시작" MinWidth="118" Style="{StaticResource PrimaryButton}" Click="Accept_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
